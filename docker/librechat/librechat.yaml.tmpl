# =============================================================================
# LibreChat configuration — Enterprise AI Platform
# -----------------------------------------------------------------------------
# LibreChat resolves ${ENV_VAR} references at load time from the container
# environment, so this file is copied verbatim to librechat.yaml by install.sh.
# Providers whose API key env var is empty are simply unavailable at runtime.
# Docs: https://www.librechat.ai/docs/configuration/librechat_yaml
# =============================================================================
version: 1.2.1
cache: true

# Local registration is disabled in favour of Keycloak OIDC (see .env).
registration:
  socialLogins:
    - openid

# Rate limiting at the application layer (NGINX adds another layer at the edge).
rateLimits:
  fileUploads:
    ipMax: 100
    ipWindowInMinutes: 60
    userMax: 50
    userWindowInMinutes: 60
  conversationsImport:
    ipMax: 100
    ipWindowInMinutes: 60

endpoints:
  # ---------------------------------------------------------------------------
  # Azure OpenAI — configured from environment variables.
  # ---------------------------------------------------------------------------
  azureOpenAI:
    titleModel: "gpt-4o-mini"
    plugins: true
    groups:
      - group: "azure-openai"
        apiKey: "${AZURE_OPENAI_API_KEY}"
        instanceName: "${AZURE_OPENAI_INSTANCE_NAME}"
        version: "${AZURE_OPENAI_API_VERSION}"
        models:
          "${AZURE_OPENAI_DEPLOYMENT_NAME}":
            deploymentName: "${AZURE_OPENAI_DEPLOYMENT_NAME}"

  # ---------------------------------------------------------------------------
  # Custom OpenAI-compatible endpoints (Ollama).
  # OpenAI, Anthropic and Google are auto-enabled from their *_API_KEY env vars.
  # ---------------------------------------------------------------------------
  custom:
    - name: "Ollama"
      apiKey: "ollama"
      baseURL: "${OLLAMA_BASE_URL}/v1"
      models:
        default:
          - "llama3.1"
          - "llama3"
          - "mistral"
          - "qwen2.5"
        fetch: true
      titleConvo: true
      titleModel: "current_model"
      summarize: false
      modelDisplayLabel: "Ollama"

# File handling / uploads.
fileConfig:
  endpoints:
    default:
      fileLimit: 10
      fileSizeLimit: 50
      totalSizeLimit: 100
  serverFileSizeLimit: 100
  avatarSizeLimit: 4

# Interface tweaks.
interface:
  privacyPolicy:
    externalUrl: "https://${CHAT_HOST}/privacy"
    openNewTab: true
  termsOfService:
    externalUrl: "https://${CHAT_HOST}/terms"
    openNewTab: true
  endpointsMenu: true
  modelSelect: true
  parameters: true
  sidePanel: true
  presets: true
