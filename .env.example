# =============================================================================
# Enterprise AI Platform — environment configuration
# =============================================================================
# This file is the TEMPLATE. `install.sh` (via scripts/gen-secrets.sh) copies it
# to `.env` and replaces every auto-generated placeholder with a strong random
# secret. Do NOT commit the generated `.env` (see .gitignore).
#
# You normally only need to edit:
#   - BASE_DOMAIN
#   - ACME_EMAIL
#   - the model provider API keys at the bottom (optional)
# Everything else is generated automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / domains
# -----------------------------------------------------------------------------
# Public base domain. Subdomains chat./auth./flow./trace. must resolve to this
# host (A/AAAA records) before Let's Encrypt can issue certificates.
BASE_DOMAIN=example.com

# Per-service public hostnames. gen-secrets.sh derives these from BASE_DOMAIN.
CHAT_HOST=chat.example.com
AUTH_HOST=auth.example.com
FLOW_HOST=flow.example.com
TRACE_HOST=trace.example.com

# Email used for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@example.com
# Set to 1 to use the Let's Encrypt staging CA (untrusted certs, high rate
# limits) while testing. Set to 0 for real, trusted certificates.
ACME_STAGING=0

# Compose project name and timezone.
COMPOSE_PROJECT_NAME=aiplatform
TZ=UTC

# -----------------------------------------------------------------------------
# Image tags (override to pin specific versions)
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MONGO_IMAGE=mongo:7
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
LANGFLOW_IMAGE=langflowai/langflow:1.10.1
LANGFUSE_WEB_IMAGE=langfuse/langfuse:3
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
MINIO_IMAGE=minio/minio:RELEASE.2024-09-22T00-33-43Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-09-16T17-43-14Z
LIBRECHAT_IMAGE=ghcr.io/danny-avila/librechat:latest
NGINX_IMAGE=nginx:1.27-alpine
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.6.0
CERTBOT_IMAGE=certbot/certbot:latest
FLOWER_IMAGE=mher/flower:2.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.108.0

# Monitoring profile images
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.15.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.62.0
NGINX_EXPORTER_IMAGE=nginx/nginx-prometheus-exporter:1.3.0

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=__GENERATED__
# Maintenance/initial database for the superuser.
POSTGRES_DB=postgres

# Per-service databases, owners and passwords (least privilege).
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=__GENERATED__

LANGFLOW_DB_NAME=langflow
LANGFLOW_DB_USER=langflow
LANGFLOW_DB_PASSWORD=__GENERATED__

LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=__GENERATED__

# -----------------------------------------------------------------------------
# Redis (shared; separate logical DB numbers per consumer)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATED__
REDIS_MAXMEMORY=512mb
# Logical DB allocation:
#   0 = LibreChat cache / general     1 = LangFlow Celery broker
#   2 = LangFlow result backend       3 = Langfuse queue/cache
REDIS_DB_LIBRECHAT=0
REDIS_DB_LANGFLOW_BROKER=1
REDIS_DB_LANGFLOW_BACKEND=2
REDIS_DB_LANGFUSE=3

# -----------------------------------------------------------------------------
# MongoDB (LibreChat primary datastore)
# -----------------------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=librechat
MONGO_INITDB_ROOT_PASSWORD=__GENERATED__
MONGO_DB_NAME=LibreChat

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_REALM=AIPlatform
# Bootstrap (master realm) admin — used for initial provisioning only.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATED__

# Confidential client secrets (one per application).
KEYCLOAK_CLIENT_SECRET_LIBRECHAT=__GENERATED__
KEYCLOAK_CLIENT_SECRET_LANGFLOW=__GENERATED__
KEYCLOAK_CLIENT_SECRET_LANGFUSE=__GENERATED__

# Seed users created in the realm (passwords generated). Roles/groups:
#   admin -> Admins/Admin   developer -> Developers/Developer   user -> Users/User
KEYCLOAK_SEED_ADMIN_USERNAME=platform-admin
KEYCLOAK_SEED_ADMIN_EMAIL=admin@example.com
KEYCLOAK_SEED_ADMIN_PASSWORD=__GENERATED__
KEYCLOAK_SEED_DEVELOPER_USERNAME=platform-dev
KEYCLOAK_SEED_DEVELOPER_EMAIL=dev@example.com
KEYCLOAK_SEED_DEVELOPER_PASSWORD=__GENERATED__
KEYCLOAK_SEED_USER_USERNAME=platform-user
KEYCLOAK_SEED_USER_EMAIL=user@example.com
KEYCLOAK_SEED_USER_PASSWORD=__GENERATED__

# -----------------------------------------------------------------------------
# LibreChat
# -----------------------------------------------------------------------------
# Encryption keys (must be exact lengths). gen-secrets.sh produces correct sizes.
LIBRECHAT_CREDS_KEY=__GENERATED__          # 64 hex chars (32 bytes)
LIBRECHAT_CREDS_IV=__GENERATED__           # 32 hex chars (16 bytes)
LIBRECHAT_JWT_SECRET=__GENERATED__
LIBRECHAT_JWT_REFRESH_SECRET=__GENERATED__
# Allow self-registration via local form? OIDC is the intended path.
LIBRECHAT_ALLOW_REGISTRATION=false
LIBRECHAT_ALLOW_SOCIAL_LOGIN=true
LIBRECHAT_ALLOW_EMAIL_LOGIN=false

# OIDC (Keycloak) for LibreChat
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=__GENERATED__         # mirrors KEYCLOAK_CLIENT_SECRET_LIBRECHAT
OPENID_SCOPE=openid profile email
OPENID_SESSION_SECRET=__GENERATED__
OPENID_BUTTON_LABEL=Sign in with Keycloak
OPENID_AUTO_REDIRECT=false

# -----------------------------------------------------------------------------
# LangFlow (production: gunicorn + Celery workers + Redis queue)
# -----------------------------------------------------------------------------
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=__GENERATED__
LANGFLOW_SECRET_KEY=__GENERATED__
# LangFlow web workers. Defaults to 1: each worker imports the full component
# library (~1-1.5 GB), so on memory-constrained hosts a single worker + a hard
# memory cap (see deploy.resources in docker-compose.yml) avoids OOM/canvas lag.
# Multi-worker is still supported via the shared Redis job queue below
# (LANGFLOW_JOB_QUEUE_TYPE=redis); LangFlow 1.10 refuses to start with >1 worker
# without it. Scale up only on a host with headroom, e.g. 6 cores / 16 GB -> 4.
LANGFLOW_WORKERS=1

# Shared job queue so multiple web workers can coordinate flow builds/events.
# Keep 'redis' to allow LANGFLOW_WORKERS > 1 (the queue URL is built from the
# Redis settings above in docker-compose.yml).
LANGFLOW_JOB_QUEUE_TYPE=redis
# Per-request hard timeout (seconds) for long-running flow executions.
LANGFLOW_WORKER_TIMEOUT=300
# Preload the app in the master process before forking workers. Off by default:
# preloading loads the full component library at startup; with N workers that's
# N copies in RAM. Leave false for memory-constrained hosts (lazy on-demand load).
LANGFLOW_PRELOAD=false
# Redis-backed task queue (Celery broker + result backend).
LANGFLOW_REDIS_QUEUE=redis://default:__GENERATED__@redis:6379/1
# Celery worker concurrency and autoscale bounds (max,min).
LANGFLOW_WORKER_CONCURRENCY=4
LANGFLOW_WORKER_AUTOSCALE=8,2
# Number of dedicated Celery worker container replicas. NOTE: the pinned LangFlow
# (1.10.x) has no Celery worker app — it runs execution in the web tier / its
# internal job queue — so this defaults to 0. Set >0 only on a LangFlow version
# that ships the Celery worker (see docs/scaling.md). Also tunable at runtime
# with `docker compose up --scale langflow-worker=N`.
LANGFLOW_WORKER_REPLICAS=0
# Log level (DEBUG/INFO/WARNING/ERROR). ERROR by default to cut memory-heavy
# log I/O thrash; raise to INFO/DEBUG only when debugging.
LANGFLOW_LOG_LEVEL=ERROR

# Flower (Celery queue dashboard) basic-auth credentials.
FLOWER_USER=flower
FLOWER_PASSWORD=__GENERATED__

# -----------------------------------------------------------------------------
# Langfuse (v3: Postgres + ClickHouse + Redis + MinIO/S3)
# -----------------------------------------------------------------------------
LANGFUSE_NEXTAUTH_SECRET=__GENERATED__
LANGFUSE_SALT=__GENERATED__
LANGFUSE_ENCRYPTION_KEY=__GENERATED__      # 64 hex chars (32 bytes)
LANGFUSE_TELEMETRY_ENABLED=false

# Deterministic bootstrap (creates org, project, admin user and API keys on first
# boot). The API keys below are auto-wired into LangFlow for tracing.
LANGFUSE_INIT_ORG_ID=aiplatform-org
LANGFUSE_INIT_ORG_NAME=AI Platform
LANGFUSE_INIT_PROJECT_ID=aiplatform-project
LANGFUSE_INIT_PROJECT_NAME=AI Platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-__GENERATED__
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-__GENERATED__
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Platform Admin
LANGFUSE_INIT_USER_PASSWORD=__GENERATED__

# Keycloak SSO for Langfuse
LANGFUSE_AUTH_KEYCLOAK_CLIENT_ID=langfuse
LANGFUSE_AUTH_KEYCLOAK_CLIENT_SECRET=__GENERATED__  # mirrors KEYCLOAK_CLIENT_SECRET_LANGFUSE
# Allow username/password sign-in in addition to SSO.
LANGFUSE_AUTH_DISABLE_PASSWORD_LOGIN=false

# ClickHouse (Langfuse analytics store)
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=__GENERATED__
CLICKHOUSE_DB=langfuse

# MinIO (S3-compatible event/media store for Langfuse)
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=__GENERATED__
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# oauth2-proxy (Keycloak gate in front of LangFlow)
# -----------------------------------------------------------------------------
OAUTH2_PROXY_CLIENT_ID=langflow
OAUTH2_PROXY_CLIENT_SECRET=__GENERATED__   # mirrors KEYCLOAK_CLIENT_SECRET_LANGFLOW
OAUTH2_PROXY_COOKIE_SECRET=__GENERATED__   # 32 url-safe bytes

# -----------------------------------------------------------------------------
# LangFlow -> Langfuse tracing (auto-wired; do not edit unless you know why)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-__GENERATED__    # mirrors LANGFUSE_INIT_PROJECT_PUBLIC_KEY
LANGFUSE_SECRET_KEY=sk-lf-__GENERATED__    # mirrors LANGFUSE_INIT_PROJECT_SECRET_KEY
LANGFUSE_HOST=http://langfuse-web:3000

# -----------------------------------------------------------------------------
# Monitoring (optional "monitoring" profile)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATED__
# Local-only bind for the Grafana UI (reach via SSH tunnel or add a vhost).
GRAFANA_BIND=127.0.0.1:3001

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Model providers (optional — leave blank to disable an endpoint)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_INSTANCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Ollama (self-hosted). Point at your Ollama server; default assumes host gateway.
OLLAMA_BASE_URL=http://host.docker.internal:11434
